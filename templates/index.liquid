      <button class="btn" id="hero-send-btn">Отправить</button>
    </div>
  </div>
</section>

<script>
  (function() {
    var heroRequestBtn = document.getElementById('hero-request-btn');
    var heroPhoneBlock = document.getElementById('hero-phone-block');
    var heroSendBtn = document.getElementById('hero-send-btn');
    if (heroRequestBtn) {
      heroRequestBtn.addEventListener('click', function(e) {
        e.preventDefault();
        heroRequestBtn.style.display = 'none';
        heroPhoneBlock.style.display = 'block';
      });
    }
    if (heroSendBtn) {
      heroSendBtn.addEventListener('click', function() {
        var org = document.getElementById('hero-org').value.trim();
        var name = document.getElementById('hero-name').value.trim();
        var phone = document.getElementById('hero-phone').value.trim();
        if (!phone) { alert('Введите телефон'); return; }
        var body = 'Здравствуйте!\n\nПрошу отправить прайс-лист на опоры.\n';
        if (org) body += 'Организация: ' + org + '\n';
        if (name) body += 'Имя: ' + name + '\n';
        body += 'Контактный телефон: ' + phone + '\n\nСпасибо!';
        window.location.href = 'mailto:veles.mf@yandex.ru?subject=' + encodeURIComponent('Запрос прайс-листа') + '&body=' + encodeURIComponent(body);
      });
    }
  })();
</script>

