</style>

<div class="vl-product-wrapper">
  <!-- ===== МИКРОРАЗМЕТКА SCHEMA.ORG ДЛЯ ТОВАРА (ПОЛНАЯ B2B С АВТО-ХАРАКТЕРИСТИКАМИ) ===== -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": "{{ product.title | escape }}",
      "description": "{{ product.description | strip_html | strip_newlines | escape | truncate: 300 }}",
      "sku": "{{ product.variants.first.sku | escape }}",
      "brand": {
        "@type": "Brand",
        "name": "Veles Legs"
      },
      "manufacturer": {
        "@type": "Organization",
        "name": "ВЕЛЕС, ФК, ООО",
        "description": "Производитель мебельных опор из дерева и металла",
        "url": "https://veles-legs.ru"
      },
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "RUB",
        "lowPrice": "{{ product.variants.first.price | money_without_currency | replace: ',', '.' | replace: ' ', '' }}",
        "highPrice": "{{ product.variants.last.price | money_without_currency | replace: ',', '.' | replace: ' ', '' }}",
        "offerCount": "{{ product.variants.size }}",
        "availability": "{% if product.variants.first.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
        "url": "https://veles-legs.ru{{ product.url }}",
        "seller": {
          "@type": "Organization",
          "name": "Veles Legs"
        },
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "applicableCountry": "RU",
          "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
          "merchantReturnDays": 14,
          "returnMethod": "https://schema.org/ReturnByMail",
          "returnFees": "https://schema.org/FreeReturn"
        },
        "shippingDetails": [
          {
            "@type": "OfferShippingDetails",
            "shippingRate": {
              "@type": "MonetaryAmount",
              "value": 0,
              "currency": "RUB"
            },
            "shippingDestination": {
              "@type": "DefinedRegion",
              "addressCountry": "RU"
            },
            "deliveryTime": {
              "@type": "ShippingDeliveryTime",
              "businessDays": {
                "@type": "OpeningHoursSpecification",
                "dayOfWeek": [
                  "https://schema.org/Monday",
                  "https://schema.org/Tuesday",
                  "https://schema.org/Wednesday",
                  "https://schema.org/Thursday",
                  "https://schema.org/Friday"
                ]
              },
              "cutoffTime": "18:00",
              "handlingTime": {
                "@type": "QuantitativeValue",
                "minValue": 0,
                "maxValue": 1,
                "unitCode": "DAY"
              },
              "transitTime": {
                "@type": "QuantitativeValue",
                "minValue": 1,
                "maxValue": 5,
                "unitCode": "DAY"
              }
            }
          }
        ]
      },
      "image": [
        "{% if product.images.first.original_url %}{{ product.images.first.original_url }}{% elsif product.default_image.original_url %}{{ product.default_image.original_url }}{% else %}https://veles-legs.ru/assets/no-image.jpg{% endif %}"
      ],
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "Минимальный заказ",
          "value": "От 100 штук"
        },
        {
          "@type": "PropertyValue",
          "name": "Тип продажи",
          "value": "Опт"
        }{% for characteristic in product.characteristics %},
        {
          "@type": "PropertyValue",
          "name": "{{ characteristic.property.title | escape }}",
          "value": "{{ characteristic.title | escape }}"
        }{% endfor %}
      ]
    }
  </script>
  <!-- ===== КОНЕЦ МИКРОРАЗМЕТКИ ===== -->

  <!-- ===== ЗАГОЛОВОК ТОВАРА ===== -->
  <h1 class="product-title">{{ product.title }}</h1>

  <!-- ВИДЖЕТ ТОВАРА -->
  {% for widgetDrop in widget_lists.product-list.widgets %}
    {% widget widgetDrop %}
  {% endfor %}

  <!-- ===== АВТОМАТИЧЕСКОЕ HTML-ОПИСАНИЕ ТОВАРА ===== -->
  {% if product.characteristics.size > 0 %}
  <div class="vl-auto-description">
    <h2>Общее описание</h2>
    <p><strong>{{ product.title }}</strong> — высококачественная мебельная опора от российского производителя Veles Legs. Изготовлена с соблюдением строгих стандартов качества, предназначена для установки на диваны, кровати, кресла и корпусную мебель. Надёжная конструкция обеспечивает долговечность эксплуатации.</p>

    <h2>Ключевые характеристики</h2>
    <ul>
      {% for characteristic in product.characteristics %}
        <li><strong>{{ characteristic.property.title }}:</strong> {{ characteristic.title }}</li>
      {% endfor %}
    </ul>

    <h2>Преимущества</h2>
    <ul>
      <li>Высокое качество материалов и сборки.</li>
      <li>Надёжная фиксация и простота монтажа.</li>
      <li>Эстетичный внешний вид, подходит для современных и классических интерьеров.</li>
      <li>Подходит для многократного использования в условиях высоких нагрузок.</li>
      <li>Производство в России — гарантия соответствия ГОСТам.</li>
    </ul>

    <h2>Индивидуальное изготовление</h2>
    <p>По вашему запросу мы изготавливаем опоры <strong>нестандартных габаритов</strong> — с изменённой высотой, диаметром, типом крепления или заглушки. Геометрия, финишное покрытие и материал согласовываются индивидуально. Строгое соблюдение технологий гарантирует безупречное качество каждой партии.</p>

    <h2>Условия заказа</h2>
    <ul>
      <li>✅ Минимальный заказ — от 100 штук (для оптовых клиентов).</li>
      <li>✅ Изготовление от 5 рабочих дней.</li>
      <li>✅ Доставка по согласованию транспортной компанией в пределах Подольска.</li>
      <li>✅ Гарантия качества на все изделия.</li>
    </ul>

    <h2>Где применяется</h2>
    <ul>
      <li>диваны и кресла;</li>
      <li>кровати и матрасные основания;</li>
      <li>корпусная мебель (столы, стулья, тумбы);</li>
      <li>специализированная мебель (медицинская, офисная).</li>
    </ul>

    <p><strong>Для заказа или консультации свяжитесь с нами по телефону или email — мы поможем подобрать оптимальное решение для вашего проекта.</strong></p>
  </div>
  {% endif %}
  <!-- ===== КОНЕЦ АВТОМАТИЧЕСКОГО ОПИСАНИЯ ===== -->

  <!-- КНОПКА НАЗАД (без подчёркивания) -->
  <a href="/" class="vl-back-link" aria-label="Вернуться на главную страницу">← Вернуться на главную</a>
</div>

<!-- ===== СКРИПТ ДЛЯ УЛУЧШЕНИЯ ДОСТУПНОСТИ И СКОРОСТИ ===== -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Добавляем aria-label к кнопкам корзины
  var cartButtons = document.querySelectorAll('.product__cart, .product__buy, .add-cart, .btn-buy, .product__add-to-cart button, .product__buy-button');
  cartButtons.forEach(function(btn) {
    if (!btn.hasAttribute('aria-label')) {
      btn.setAttribute('aria-label', 'Добавить товар в корзину');
    }
  });

  // Добавляем aria-label к ссылкам избранного и сравнения
  var favoriteLinks = document.querySelectorAll('.product__actions a[href*="favorite"]');
  favoriteLinks.forEach(function(link) {
    if (!link.hasAttribute('aria-label')) {
      link.setAttribute('aria-label', 'Добавить в избранное');
    }
  });

  var compareLinks = document.querySelectorAll('.product__actions a[href*="compare"]');
  compareLinks.forEach(function(link) {
    if (!link.hasAttribute('aria-label')) {
      link.setAttribute('aria-label', 'Добавить к сравнению');
    }
  });

  // БЕЗОПАСНАЯ ОПТИМИЗАЦИЯ: Приоритет для главного фото БЕЗ изменения размеров (чтобы не было сдвигов CLS)
  var productImg = document.querySelector('.vl-product-wrapper .product__image img, .vl-product-wrapper .product-image img, .vl-product-wrapper .product-photo img');
  if (productImg) {
    productImg.removeAttribute('loading');
    productImg.setAttribute('loading', 'eager');
    productImg.setAttribute('fetchpriority', 'high');
  }
});
</script>
