  .vl-product-wrapper .product-description h3,
  .vl-product-wrapper .product__content h3,
  .vl-product-wrapper .product__characteristics h3,
  .vl-product-wrapper .characteristics h3,
  .vl-product-wrapper .product__reviews h3,
  .vl-product-wrapper .reviews h3 {
